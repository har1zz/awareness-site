# Copy to .env.local (local) or set in your host's dashboard (production).
# Every NEXT_PUBLIC_ value is printed on public pages (footer, privacy, terms),
# so only enter details you are happy to publish.

NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_OPERATOR_NAME=Your Full Legal Name
NEXT_PUBLIC_OPERATOR_ADDRESS=A postal or contact address you are willing to publish
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.example
# Optional: defaults to the contact email
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
NEXT_PUBLIC_HOSTING_PROVIDER=Name of your host (e.g. Vercel, Netlify, your VPS company)
NEXT_PUBLIC_HOSTING_REGION=Country/region where the host stores logs

# --- Supabase (server only; never prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DATABASE_REGION=
